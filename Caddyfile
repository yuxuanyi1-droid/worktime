{
	admin off
	auto_https off
}

# ⚠️ 重要：本文件所有 API 路径（agent 亲和路由、两处 health_uri）都用 {$BASE_PATH} 前缀拼出，
# 必须与根 .env 的 BASE_PATH 保持一致：
#   - BASE_PATH=/worktime  →  /worktime/api/...
#   - BASE_PATH 未设置     →  /api/...（与 .env.example 默认的根路径部署一致，不会命中 SPA fallback）
# 使用 server/scripts/production-stack.sh 启动时 BASE_PATH 会自动从根 .env 读取并透传给 Caddy；
# 手工启动 Caddy（caddy run）时请先 source 根 .env 或 export BASE_PATH。
# {$BASE_PATH} 与下方 {$CADDY_LB_COOKIE_SECRET} 同属 Caddyfile 环境变量展开语法（解析期替换，
# 未设置时展开为空串，不报错）。若需要改 BASE_PATH，只改根 .env 即可，本文件无需手工同步。

# 工时系统统一入口。接受 Tunnel 保留的公网 Host，但仅在本机回环地址监听。
http://:3000 {
	bind 127.0.0.1 ::1

	# 排除 SSE 不做压缩：encode 会缓冲流式输出，导致 AI 聊天逐字输出被积压。
	# 语法为 Caddy 官方 encode 指令的 match 子句（not header 匹配 Content-Type 非 text/event-stream）。
	encode zstd gzip {
		match {
			not header Content-Type text/event-stream
		}
	}

	route {
		# AI 会话与 SSE 回调驻留在单个 API 实例内。首次访问由 Caddy 写入亲和 Cookie，
		# 后续创建、流式聊天、排队和停止请求必须回到同一实例。
		@agent path {$BASE_PATH}/api/v1/agent/*
		reverse_proxy @agent 127.0.0.1:3011 127.0.0.1:3012 127.0.0.1:3013 {
			lb_policy cookie worktime_ai_upstream {$CADDY_LB_COOKIE_SECRET}

			health_uri {$BASE_PATH}/api/health
			health_interval 10s
			health_timeout 2s
			health_status 200
			fail_duration 30s
			max_fails 2
			lb_try_duration 2s
			lb_try_interval 100ms
		}

		# 其他短请求继续按当前连接数均衡，避免 AI 长连接影响普通 API 分配。
		reverse_proxy 127.0.0.1:3011 127.0.0.1:3012 127.0.0.1:3013 {
			lb_policy least_conn

			health_uri {$BASE_PATH}/api/health
			health_interval 10s
			health_timeout 2s
			health_status 200
			fail_duration 30s
			max_fails 2
			lb_try_duration 2s
			lb_try_interval 100ms
		}
	}
}
